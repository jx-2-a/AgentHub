{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "composite": true,
    "moduleDetection": "force"
  },
  "include": ["vite.config.ts", "scripts"]
}
